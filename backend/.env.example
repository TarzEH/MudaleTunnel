# Copy to backend/.env and fill in. Never commit the filled-in file.
#
#   cp backend/.env.example backend/.env
#   python -c "import secrets; print(secrets.token_urlsafe(64))"   # SECRET_KEY

# ── Required ────────────────────────────────────────────────────────────
MUDALE_SECRET_KEY=

# ── Database ────────────────────────────────────────────────────────────
MUDALE_DB_NAME=mudale
MUDALE_DB_USER=mudale
MUDALE_DB_PASSWORD=mudale-dev-password
MUDALE_DB_HOST=127.0.0.1
MUDALE_DB_PORT=5432

# ── Redis (Channels layer) ──────────────────────────────────────────────
MUDALE_REDIS_URL=redis://127.0.0.1:6379/0

# ── HTTP ────────────────────────────────────────────────────────────────
# Comma-separated. Must not contain '*' in production — prod settings refuse to start.
MUDALE_ALLOWED_HOSTS=localhost,127.0.0.1
MUDALE_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
MUDALE_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# Move the admin off a guessable path in any deployment reachable from a client network.
MUDALE_ADMIN_PATH=admin

# ── Engine ──────────────────────────────────────────────────────────────
MUDALE_SSH_BIN=ssh
MUDALE_NMAP_BIN=nmap

MUDALE_ENGINE_RECONCILE_INTERVAL=5
MUDALE_ENGINE_STOP_GRACE=10
MUDALE_MAX_CONCURRENT_TUNNELS=64
MUDALE_SCAN_TIMEOUT=3600

# ── Demo mode ───────────────────────────────────────────────────────────
# Prints these on the sign-in page so a fresh install is usable immediately.
# Honoured ONLY when MUDALE_ALLOWED_HOSTS is loopback-only; withheld otherwise.
# Seed the matching account with: python manage.py seed_demo
MUDALE_DEMO_CREDENTIALS=operator:mudale-demo-2026

# ── Logging ─────────────────────────────────────────────────────────────
MUDALE_LOG_LEVEL=INFO
