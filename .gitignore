# Written for this project rather than inherited from a template.
#
# The previous version was a generic Python .gitignore with ad-hoc additions,
# and one of its rules was a bare `test.py`. That silently excluded
# backend/mudale/settings/test.py, so CI could not import its own settings
# module — the file existed on every developer's disk and in no clone.
#
# Rules here are anchored (leading /) or specific on purpose: a bare filename
# matches at every depth, which is exactly how that happened.

# ── Secrets ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
known_hosts

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
/backend/.venv/
/backend/build/
/backend/dist/
/backend/staticfiles/
/backend/var/
*.spec
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Standalone state (SQLite, daemon PID) ──────────────────────────────
mudale.db

# ── Node / dashboard ────────────────────────────────────────────────────
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
npm-debug.log*

# ── Tooling scratch ─────────────────────────────────────────────────────
.playwright-mcp/
/docs/demo.mp4
/docs/walkthrough-metasploitable.md

# ── Lock files (uv) ────────────────────────────────────────────────────
/backend/uv.lock

# ── Editors and OS ──────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
